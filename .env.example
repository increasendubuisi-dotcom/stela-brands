# Copy to apps/web/.env.local for local development. Never commit real values.

# Supabase project (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for publishing snapshots and storage signing. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the designer app and of published guides
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GUIDE_BASE_URL=http://localhost:3000/g

# Phase 2 (AI). Server only.
OPENAI_API_KEY=

# Phase 4 (billing). Server only.
PAYSTACK_SECRET_KEY=
